{
  "name": "agent-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Modular Agent OS for live streamers and content creators",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @agent/desktop dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@agent/event-bus": "workspace:*",
    "@agent/logging": "workspace:*",
    "@agent/orchestrator": "workspace:*",
    "@agent/permission-manager": "workspace:*",
    "@agent/provider-manager": "workspace:*",
    "@agent/workflow-engine": "workspace:*",
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
